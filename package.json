{
  "name": "y-trix",
  "version": "0.2.4",
  "description": "Yjs binding for the Trix editor: collaborative editing, shared cursors and undo",
  "keywords": [
    "yjs",
    "trix",
    "crdt",
    "collaboration",
    "collaborative-editing",
    "rich-text"
  ],
  "author": "JP Camara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpcamara/y-trix.git"
  },
  "homepage": "https://github.com/jpcamara/y-trix#readme",
  "bugs": "https://github.com/jpcamara/y-trix/issues",
  "license": "MIT",
  "type": "module",
  "main": "src/y-trix.js",
  "types": "src/y-trix.d.ts",
  "exports": {
    ".": {
      "types": "./src/y-trix.d.ts",
      "default": "./src/y-trix.js"
    }
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "trix": ">=2.1.15",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  },
  "scripts": {
    "build:demo": "esbuild demo/main.js --bundle --format=esm --outdir=demo/dist && esbuild demo/main.js --bundle --format=esm --alias:trix=trix-2.1.15 --outfile=demo/dist/main-2.1.15.js",
    "test": "node tests/diff.unit.mjs && npm run build:demo && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65",
    "@y/websocket-server": "0.1.5",
    "esbuild": "^0.28.2",
    "trix": "^2.1.19",
    "trix-2.1.15": "npm:trix@^2.1.15",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "y-websocket-server-13": "npm:@y/websocket-server@0.1.1",
    "yjs": "^13.6.33"
  },
  "overrides": {
    "@y/protocols": "1.0.6-1"
  },
  "sideEffects": false
}
